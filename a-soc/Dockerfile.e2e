# Playwright E2E Test Runner for A-SOC Dashboard
# Connects to running services and executes tests
# Usage: docker build -t a-soc-e2e -f Dockerfile.e2e . && docker run --rm --network host a-soc-e2e

FROM node:20-slim

# Install system dependencies for Chromium
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Node.js dependencies
COPY dashboard/package.json ./
RUN rm -f package-lock.json && npm install --legacy-peer-deps

# Install Playwright test package and browsers
RUN npm install --save-dev @playwright/test && \
    npx playwright install --with-deps chromium

# Copy test files
COPY dashboard/playwright.config.ts ./
COPY dashboard/e2e ./e2e/

# Set test environment
ENV TEST_BASE_URL=http://localhost:3000
ENV PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright

# Run tests
CMD ["npx", "playwright", "test", "--reporter=list"]
